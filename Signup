<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign up | Gear Radar Digital Solutions</title>
<meta name="description" content="Sign up for the Gear Radar AI assistant, AI Job Hunter or a bundle. English and Arabic.">
<meta name="robots" content="noindex">
<link rel="canonical" href="https://www.gearradar.co.uk/signup.html">
<meta name="theme-color" content="#0B1220">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230B1220'/%3E%3Ccircle cx='32' cy='32' r='18' fill='none' stroke='%23E8B64C' stroke-width='4'/%3E%3Ccircle cx='32' cy='32' r='8' fill='none' stroke='%23E8B64C' stroke-width='4' opacity='.6'/%3E%3Cpath d='M32 32 L46 18' stroke='%23F5CD6E' stroke-width='4' stroke-linecap='round'/%3E%3Ccircle cx='32' cy='32' r='3.5' fill='%23F5CD6E'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0B1220; --ink-2:#111B2F; --ink-3:#1A2640;
  --gold:#E8B64C; --gold-2:#F5CD6E; --gold-soft:rgba(232,182,76,.12);
  --paper:#F7F5F0; --white:#FFFFFF; --text:#0F172A; --muted:#5B6475; --line:#E6E2D8;
  --on-ink:#E8ECF4; --on-ink-muted:#9AA6BC; --ok:#22C55E; --err:#b91c1c;
  --radius:18px;
  --font-head:'Sora',system-ui,sans-serif; --font-body:'Inter',system-ui,sans-serif;
}
html[lang="ar"]{ --font-head:'Cairo',system-ui,sans-serif; --font-body:'Cairo',system-ui,sans-serif; }
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-body);color:var(--text);background:var(--paper);line-height:1.6;-webkit-font-smoothing:antialiased}
svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
.container{width:min(880px,100% - 32px);margin-inline:auto}
h1,h2,h3{font-family:var(--font-head);line-height:1.2;letter-spacing:-.02em}
html[lang="ar"] h1,html[lang="ar"] h2,html[lang="ar"] h3{letter-spacing:0;line-height:1.4}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:6px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 26px;border-radius:999px;font-weight:600;font-size:.97rem;border:1px solid transparent;cursor:pointer;transition:background .2s,border-color .2s,color .2s}
.btn-gold{background:var(--gold);color:var(--ink)}
.btn-gold:hover{background:var(--gold-2)}
.btn-line{background:transparent;border-color:var(--line);color:var(--text)}
.btn-line:hover{border-color:var(--gold)}
.btn[disabled]{opacity:.6;cursor:wait}

/* Header */
header{background:var(--ink);color:var(--on-ink)}
.nav{display:flex;align-items:center;justify-content:space-between;height:70px;gap:16px}
.brand{display:flex;align-items:center;gap:10px;color:var(--white);font-family:'Sora',sans-serif;font-weight:700;font-size:1.05rem}
.brand svg{width:36px;height:36px;flex:none}
.lang{background:transparent;border:1px solid rgba(232,236,244,.25);color:var(--on-ink);padding:8px 14px;border-radius:999px;font-size:.88rem;font-weight:600;cursor:pointer;font-family:'Cairo','Inter',sans-serif}
.lang:hover{border-color:var(--gold);color:var(--gold)}
.intro{background:var(--ink);color:var(--on-ink);padding:26px 0 90px}
.intro h1{color:var(--white);font-size:clamp(1.7rem,4vw,2.4rem);margin-bottom:8px}
.intro p{color:var(--on-ink-muted);max-width:620px}
.back{display:inline-flex;gap:6px;align-items:center;color:var(--on-ink-muted);font-size:.9rem;margin-bottom:18px}
.back:hover{color:var(--gold)}
html[dir="rtl"] .back svg{transform:scaleX(-1)}

/* Form */
main{margin-top:-60px;padding-bottom:80px}
form,.done{background:var(--white);border:1px solid var(--line);border-radius:22px;padding:34px;box-shadow:0 20px 50px -30px rgba(11,18,32,.35)}
fieldset{border:0;display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-bottom:28px;margin-bottom:28px;border-bottom:1px solid var(--line)}
fieldset:last-of-type{border-bottom:0;margin-bottom:0}
legend{grid-column:1/-1;font-family:var(--font-head);font-weight:700;font-size:1.15rem;margin-bottom:14px;display:flex;align-items:center;gap:10px}
legend .n{width:28px;height:28px;border-radius:50%;background:var(--ink);color:var(--gold);display:inline-grid;place-items:center;font-size:.85rem;flex:none}
.field{display:grid;gap:6px;align-content:start}
.full{grid-column:1/-1}
label,.label{font-size:.88rem;font-weight:600}
.opt{font-weight:400;color:var(--muted)}
.hint{font-size:.82rem;color:var(--muted)}
input,select,textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--paper);color:var(--text);transition:border-color .2s,background .2s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--gold);background:var(--white)}
input[type="tel"],input[type="email"]{direction:ltr}
html[dir="rtl"] input[type="tel"],html[dir="rtl"] input[type="email"]{text-align:right}
.invalid input,.invalid select,input.invalid,select.invalid{border-color:var(--err);background:#fef2f2}
.err-text{font-size:.82rem;color:var(--err);display:none}
.invalid .err-text{display:block}

/* Plan picker */
.plans{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.plan{position:relative}
.plan input{position:absolute;top:0;left:0;opacity:0;pointer-events:none}
.plan label{display:grid;gap:2px;padding:14px 16px;border:1.5px solid var(--line);border-radius:14px;background:var(--paper);cursor:pointer;height:100%;transition:border-color .2s,background .2s}
.plan label:hover{border-color:#d8c79c}
.plan input:checked + label{border-color:var(--gold);background:#FFF9EC;box-shadow:0 0 0 3px var(--gold-soft)}
.plan input:focus-visible + label{outline:3px solid var(--gold);outline-offset:2px}
.plan .cat{font-size:.72rem;font-weight:600;color:#8a6412;text-transform:uppercase;letter-spacing:.06em}
html[lang="ar"] .plan .cat{letter-spacing:0;font-size:.78rem}
.plan .nm{font-family:var(--font-head);font-weight:700;font-size:1rem}
.plan .pr{font-size:.9rem;color:var(--muted)}
.plan .pr b{color:var(--text);font-size:1.05rem}
.plan .best{position:absolute;top:-9px;inset-inline-end:12px;background:var(--ink);color:var(--gold);font-size:.7rem;font-weight:700;padding:2px 9px;border-radius:999px}
.billing{grid-column:1/-1;display:inline-flex;gap:4px;padding:4px;background:var(--paper);border:1px solid var(--line);border-radius:999px;justify-self:start}
.billing button{border:0;background:transparent;padding:8px 16px;border-radius:999px;cursor:pointer;font-weight:600;font-size:.88rem;color:var(--muted)}
.billing button[aria-pressed="true"]{background:var(--ink);color:var(--white)}
.billing .save{color:#15803d;font-weight:600}
.billing button[aria-pressed="true"] .save{color:var(--gold-2)}
.summary{grid-column:1/-1;background:var(--paper);border:1px dashed #d8c79c;border-radius:14px;padding:14px 18px;font-size:.92rem}
.summary b{font-weight:600}
.summary ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:6px;color:var(--muted);font-size:.86rem}
.summary li::before{content:"✓ ";color:#B8871F;font-weight:700}

/* Channel */
.choice{display:grid;grid-template-columns:1fr 1fr;gap:10px;grid-column:1/-1}
.choice > div{position:relative}
.choice input{position:absolute;top:0;left:0;opacity:0;pointer-events:none}
.choice label{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1.5px solid var(--line);border-radius:14px;background:var(--paper);cursor:pointer;font-weight:600}
.choice input:checked + label{border-color:var(--gold);background:#FFF9EC}
.choice input:disabled + label{opacity:.45;cursor:not-allowed}
.choice input:focus-visible + label{outline:3px solid var(--gold);outline-offset:2px}
.choice svg{width:24px;height:24px;flex:none}
.choice small{display:block;font-weight:400;color:var(--muted);font-size:.8rem}

/* File */
.drop{grid-column:1/-1;border:2px dashed var(--line);border-radius:14px;padding:22px;text-align:center;background:var(--paper);cursor:pointer;transition:border-color .2s}
.drop:hover,.drop.over{border-color:var(--gold)}
.drop.has{border-style:solid;border-color:#86c59b;background:#f0fdf4}
.drop svg{width:30px;height:30px;margin:0 auto 8px;color:#B8871F}
.drop b{display:block}
.drop.invalid-drop{border-color:var(--err);background:#fef2f2}

/* Areas */
.areas{grid-column:1/-1;display:grid;gap:10px}
.area{display:grid;grid-template-columns:1.4fr 1fr auto;gap:10px;align-items:center}
.rm{background:none;border:1px solid var(--line);border-radius:10px;width:44px;height:44px;cursor:pointer;color:var(--muted);font-size:1.2rem}
.rm:hover{border-color:var(--err);color:var(--err)}
.add{justify-self:start;background:none;border:0;color:#8a6412;font-weight:600;cursor:pointer;padding:4px 0}
.add:hover{text-decoration:underline}
.add[hidden]{display:none}
.check{display:flex;gap:10px;align-items:flex-start;font-size:.9rem;font-weight:500}
.check input{width:18px;height:18px;margin-top:3px;flex:none;accent-color:var(--ink)}
.check a{text-decoration:underline}
.hp{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
.note{grid-column:1/-1;display:flex;gap:10px;align-items:flex-start;background:#EFF6FF;border:1px solid #BFDBFE;color:#1e3a8a;border-radius:12px;padding:12px 14px;font-size:.88rem}
.note svg{width:18px;height:18px;flex:none;margin-top:3px}
.foot{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:8px}
.status{font-size:.92rem;font-weight:500}
.status.err{color:var(--err)}
.section-hide{display:none !important}

/* Done */
.done{text-align:center;padding:48px 34px}
.done .tick{width:64px;height:64px;border-radius:50%;background:#dcfce7;color:#15803d;display:grid;place-items:center;margin:0 auto 18px}
.done .tick svg{width:32px;height:32px}
.done h2{font-size:1.6rem;margin-bottom:10px}
.done p{color:var(--muted);max-width:520px;margin:0 auto 10px}
.ref{display:inline-block;font-family:'Sora',monospace;font-weight:700;letter-spacing:.08em;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:6px 14px;margin:8px 0 18px;direction:ltr}
.next{text-align:start;max-width:460px;margin:18px auto 26px;display:grid;gap:10px;list-style:none;counter-reset:n}
.next li{display:flex;gap:12px;align-items:flex-start;font-size:.95rem}
.next li::before{counter-increment:n;content:counter(n);width:26px;height:26px;border-radius:50%;background:var(--gold);color:var(--ink);font-weight:700;font-size:.8rem;display:grid;place-items:center;flex:none}

footer{background:#070C17;color:var(--on-ink-muted);padding:28px 0;font-size:.85rem}
footer .container{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer a:hover{color:var(--gold)}

@media (max-width:720px){
  form,.done{padding:22px}
  fieldset{grid-template-columns:1fr}
  .plans{grid-template-columns:1fr 1fr}
  .choice{grid-template-columns:1fr}
  .area{grid-template-columns:1fr 1fr auto}
}
@media (max-width:420px){
  .plans{grid-template-columns:1fr}
  .area{grid-template-columns:1fr auto}
  .area select{grid-column:1;grid-row:2}
  .area .rm{grid-row:1/3;grid-column:2}
}
</style>
</head>
<body>
<header>
  <div class="container nav">
    <a href="index.html" class="brand" aria-label="Gear Radar Digital Solutions">
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#16223a"/><circle cx="32" cy="32" r="18" fill="none" stroke="#E8B64C" stroke-width="3.5"/><circle cx="32" cy="32" r="8" fill="none" stroke="#E8B64C" stroke-width="3.5" opacity=".55"/><path d="M32 32 L46 18" stroke="#F5CD6E" stroke-width="3.5" stroke-linecap="round"/><circle cx="32" cy="32" r="3.5" fill="#F5CD6E"/></svg>
      <span>Gear Radar</span>
    </a>
    <button class="lang" id="langToggle" type="button" aria-label="Switch language">العربية</button>
  </div>
</header>

<section class="intro">
  <div class="container">
    <a href="index.html#pricing" class="back"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg><span data-i18n="back">Back to plans</span></a>
    <h1 data-i18n="title">Set up your account</h1>
    <p data-i18n="lead">Takes about 3 minutes. We review every signup and email you your activation link within one working day.</p>
  </div>
</section>

<main class="container">
<form id="signup" novalidate>
  <!-- 1. Plan -->
  <fieldset>
    <legend><span class="n">1</span><span data-i18n="l_plan">Choose your plan</span></legend>
    <div class="billing" role="group" aria-label="Billing">
      <button type="button" data-billing="monthly" aria-pressed="true" data-i18n="monthly">Monthly</button>
      <button type="button" data-billing="annual" aria-pressed="false"><span data-i18n="annual">Annual</span> · <span class="save" data-i18n="save">2 months free</span></button>
    </div>
    <div class="plans" id="plans"></div>
    <div class="summary" id="summary" aria-live="polite"></div>
  </fieldset>

  <!-- 2. About you -->
  <fieldset>
    <legend><span class="n">2</span><span data-i18n="l_you">About you</span></legend>
    <div class="field"><label for="full_name" data-i18n="f_name">Full name</label><input id="full_name" autocomplete="name" maxlength="120" required><span class="err-text" data-i18n="e_name">Please enter your name.</span></div>
    <div class="field"><label for="email" data-i18n="f_email">Email</label><input id="email" type="email" autocomplete="email" maxlength="160" required><span class="err-text" data-i18n="e_email">Please enter a valid email.</span></div>
    <div class="field"><label for="country" data-i18n="f_country">Country you live in</label>
      <select id="country" autocomplete="country">
        <option value="United Kingdom" data-i18n="c_gb">United Kingdom</option>
        <option value="United States" data-i18n="c_us">United States</option>
        <option value="Canada" data-i18n="c_ca">Canada</option>
        <option value="United Arab Emirates" data-i18n="c_ae">United Arab Emirates</option>
        <option value="Saudi Arabia" data-i18n="c_sa">Saudi Arabia</option>
        <option value="Qatar" data-i18n="c_qa">Qatar</option>
        <option value="Kuwait" data-i18n="c_kw">Kuwait</option>
        <option value="Bahrain" data-i18n="c_bh">Bahrain</option>
        <option value="Oman" data-i18n="c_om">Oman</option>
        <option value="Other" data-i18n="c_other">Other</option>
      </select>
    </div>
    <div class="field"><label for="language" data-i18n="f_lang">Messages in</label>
      <select id="language"><option value="en">English</option><option value="ar">العربية</option></select>
    </div>
  </fieldset>

  <!-- 3. Channel -->
  <fieldset>
    <legend><span class="n">3</span><span data-i18n="l_channel">Where should we message you?</span></legend>
    <div class="choice" id="channelBox">
      <div><input type="radio" name="channel" id="ch_tg" value="telegram" checked><label for="ch_tg"><svg viewBox="0 0 24 24" fill="#229ED9"><path d="M21.9 4.3 18.7 19.5c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.2 13.2l-4.9-1.5c-1-.3-1.1-1 .2-1.5L20.6 3c.9-.3 1.6.2 1.3 1.3z"/></svg><span>Telegram<small data-i18n="tg_hint">We'll send you a one-tap link to connect</small></span></label></div>
      <div><input type="radio" name="channel" id="ch_wa" value="whatsapp"><label for="ch_wa"><svg viewBox="0 0 24 24" fill="#25D366"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg><span>WhatsApp<small id="waHint" data-i18n="wa_hint">Messages from our business number</small></span></label></div>
    </div>
    <div class="field full section-hide" id="waField"><label for="wa_number" data-i18n="f_wa">WhatsApp number, with country code</label><input id="wa_number" type="tel" autocomplete="tel" placeholder="+44 7700 900123" maxlength="20"><span class="err-text" data-i18n="e_wa">Please enter your full number with country code, e.g. +44 7700 900123.</span></div>
  </fieldset>

  <!-- 4. Assistant -->
  <fieldset id="assistantSet">
    <legend><span class="n" data-step="assistant">4</span><span data-i18n="l_assistant">Your assistant</span></legend>
    <div class="field"><label for="google_email"><span data-i18n="f_google">Google account for Gmail &amp; Calendar</span></label><input id="google_email" type="email" maxlength="160" placeholder="you@gmail.com"><span class="hint" data-i18n="h_google">Leave blank to use your email above. You'll approve access with Google when you activate.</span><span class="err-text" data-i18n="e_google">Please enter a valid Google email.</span></div>
    <div class="field"><label for="city"><span data-i18n="f_city">Home city</span> <span class="opt" data-i18n="optional">(optional)</span></label><input id="city" maxlength="80"><span class="hint" data-i18n="h_city">For weather and travel times in your morning brief.</span></div>
    <div class="field full"><label for="timezone" data-i18n="f_tz">Time zone</label><select id="timezone"></select></div>
  </fieldset>

  <!-- 5. Jobs -->
  <fieldset id="jobsSet">
    <legend><span class="n" data-step="jobs">5</span><span data-i18n="l_jobs">Your job search</span></legend>
    <div class="drop full" id="drop" tabindex="0" role="button" aria-describedby="dropHint">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 18v-6M9 15l3-3 3 3"/></svg>
      <b id="dropText" data-i18n="drop">Upload your CV (PDF)</b>
      <span class="hint" id="dropHint" data-i18n="drop_hint">Click or drag a PDF here · max 5 MB</span>
      <input type="file" id="cv" accept="application/pdf,.pdf" hidden>
    </div>
    <span class="err-text full" id="cvErr" data-i18n="e_cv" style="margin-top:-8px">Please upload your CV as a PDF under 5 MB.</span>
    <div class="field full"><label for="titles" data-i18n="f_titles">Job titles you want</label><input id="titles" maxlength="400" placeholder="Facilities Manager, Operations Manager"><span class="hint" id="titlesHint"></span><span class="err-text" data-i18n="e_titles">Please add at least one job title.</span></div>
    <div class="field full"><span class="label" data-i18n="f_areas">Where you want to work</span><span class="hint" id="areasHint"></span></div>
    <div class="areas" id="areas"></div>
    <button type="button" class="add full" id="addArea" data-i18n="add_area">+ Add another city</button>
    <span class="err-text full" id="areasErr" data-i18n="e_areas">Please add at least one city.</span>
    <label class="check full"><input type="checkbox" id="remote" checked><span data-i18n="f_remote">Also show remote jobs</span></label>
    <div class="field"><label for="min_salary"><span data-i18n="f_salary">Minimum salary per year</span> <span class="opt" data-i18n="optional">(optional)</span></label><input id="min_salary" type="number" min="0" step="1000" inputmode="numeric"></div>
    <div class="field"><label for="currency" data-i18n="f_currency">Currency</label>
      <select id="currency"><option>GBP</option><option>USD</option><option>CAD</option><option>AED</option><option>SAR</option><option>QAR</option><option>KWD</option><option>BHD</option><option>OMR</option></select>
    </div>
  </fieldset>

  <!-- Finish -->
  <fieldset>
    <legend><span class="n" id="lastStep">6</span><span data-i18n="l_finish">Confirm</span></legend>
