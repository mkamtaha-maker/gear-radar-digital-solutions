    if (!f) return;
    var isPdf = f.type === 'application/pdf' || /\.pdf$/i.test(f.name);
    if (!isPdf || f.size > MAX_CV) { cvFile = null; drop.classList.remove('has'); drop.classList.add('invalid-drop'); $('dropText').textContent = t('drop'); $('cvErr').style.display = 'block'; return; }
    cvFile = f; drop.classList.add('has'); $('dropText').textContent = f.name; $('cvErr').style.display = 'none';
  }
  drop.addEventListener('click', function(){ fileInput.click(); });
  drop.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', function(){ setFile(fileInput.files[0]); });
  ['dragenter','dragover'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.add('over'); }); });
  ['dragleave','drop'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.remove('over'); }); });
  drop.addEventListener('drop', function(e){ setFile(e.dataTransfer.files[0]); });

  // ---------- Validation ----------
  var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  function mark(el, bad){ var f = el.closest('.field') || el; f.classList.toggle('invalid', bad); return bad; }
  function collect(){
    var p = plan(), bad = [];
    var name = $('full_name').value.trim(), email = $('email').value.trim().toLowerCase();
    if (mark($('full_name'), name.length < 2)) bad.push($('full_name'));
    if (mark($('email'), !EMAIL.test(email))) bad.push($('email'));
    var channel = $('ch_wa').checked ? 'whatsapp' : 'telegram';
    var waDigits = $('wa_number').value.replace(/\D/g, '').replace(/^00/, '');
    if (channel === 'whatsapp' && mark($('wa_number'), !/^\d{8,15}$/.test(waDigits))) bad.push($('wa_number'));
    if (channel !== 'whatsapp') mark($('wa_number'), false);
    var payload = {};
    if (p.assistant) {
      var g = $('google_email').value.trim().toLowerCase() || email;
      if (mark($('google_email'), !EMAIL.test(g) && $('google_email').value.trim() !== '')) bad.push($('google_email'));
      payload.google_email = g; payload.timezone = $('timezone').value; payload.city = $('city').value.trim();
    }
    if (p.jobs) {
      var titles = $('titles').value.split(/[,،\n]/).map(function(s){ return s.trim(); }).filter(Boolean).slice(0, p.titles);
      if (mark($('titles'), !titles.length)) bad.push($('titles'));
      var areas = Array.prototype.map.call($('areas').children, function(r){ return { label: r.querySelector('.a-label').value.trim(), country: r.querySelector('.a-country').value }; }).filter(function(a){ return a.label; });
      $('areasErr').style.display = areas.length ? 'none' : 'block';
      $('areas').querySelectorAll('.a-label').forEach(function(i, idx){ i.classList.toggle('invalid', !areas.length && idx === 0); });
      if (!areas.length) bad.push($('areas').querySelector('.a-label'));
      if (!cvFile) { drop.classList.add('invalid-drop'); $('cvErr').style.display = 'block'; bad.push(drop); }
      payload.target_titles = titles; payload.areas = areas;
      payload.allow_remote = $('remote').checked;
      var sal = Number($('min_salary').value);
      payload.min_salary = sal > 0 ? sal : null; payload.salary_currency = $('currency').value;
    }
    var consent = $('consent').checked;
    $('consentErr').style.display = consent ? 'none' : 'block';
    if (!consent) bad.push($('consent'));
    return { bad: bad, body: {
      service: p.service, plan: p.key, billing: billing,
      full_name: name, email: email, country: $('country').value, language: $('language').value,
      channel: channel, whatsapp_number: channel === 'whatsapp' ? waDigits : '',
      payload: payload, website: $('website').value
    } };
  }

  function uuid(){
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return 'x' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
  }
  function uploadCv(){
    var d = new Date(), day = d.getUTCFullYear() + ('0' + (d.getUTCMonth() + 1)).slice(-2) + ('0' + d.getUTCDate()).slice(-2);
    var path = 'incoming/' + day + '/' + uuid() + '.pdf';
    return fetch(SB_URL + '/storage/v1/object/signup-files/' + path, {
      method: 'POST',
      headers: { 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY, 'Content-Type': 'application/pdf', 'x-upsert': 'false' },
      body: cvFile
    }).then(function(r){ if (!r.ok) throw new Error('upload ' + r.status); return path; });
  }

  var status = $('status'), btn = $('submit');
  function setStatus(k, cls){ status.textContent = k ? t(k) : ''; status.className = 'status ' + (cls || ''); }

  // Map server-side validation errors back to fields
  var SERVER_FIELDS = { full_name:'full_name', email:'email', whatsapp_number:'wa_number', channel_not_in_plan:'wa_number', google_email:'google_email', target_titles:'titles' };

  $('signup').addEventListener('submit', function(ev){
    ev.preventDefault();
    var c = collect();
    if (c.bad.length) { setStatus('s_check', 'err'); var first = c.bad[0]; (first.focus ? first : first.querySelector('input')).focus(); return; }
    btn.disabled = true;
    var step = plan().jobs ? (setStatus('s_upload'), uploadCv().catch(function(e){ e.upload = true; throw e; })) : Promise.resolve(null);
    step.then(function(path){
      if (path) c.body.payload.cv_file = path;
      setStatus('s_sending');
      return fetch(ENDPOINT, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(c.body) });
    }).then(function(r){
      return r.json().catch(function(){ return {}; }).then(function(j){ return { ok: r.ok, j: j }; });
    }).then(function(res){
      if (!res.ok || !res.j.ok) {
        var errs = (res.j && res.j.errors) || [];
        errs.forEach(function(e){ if (SERVER_FIELDS[e]) mark($(SERVER_FIELDS[e]), true); if (e === 'cv_file') drop.classList.add('invalid-drop'); if (e === 'areas') $('areasErr').style.display = 'block'; });
        throw new Error('rejected');
      }
      showDone(res.j);
    }).catch(function(e){
      setStatus(e && e.upload ? 's_uperr' : (e && e.message === 'rejected' ? 's_check' : 's_err'), 'err');
    }).then(function(){ btn.disabled = false; });
  });

  function showDone(j){
    $('ref').textContent = j.ref || '—';
    $('d3').textContent = t($('ch_wa').checked ? 'd_3wa' : 'd_3tg');
    if (j.duplicate) $('done').querySelector('p').textContent = t('d_dup');
    $('signup').classList.add('section-hide');
    $('done').classList.remove('section-hide');
    $('done').focus();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ---------- Init ----------
  $('year').textContent = new Date().getFullYear();
  var initial = params.get('lang');
  if (initial !== 'ar' && initial !== 'en') { try { initial = localStorage.getItem('gr_lang') || 'en'; } catch(e) { initial = 'en'; } }
  $('areas').appendChild(areaRow());
  applyLang(initial === 'ar' ? 'ar' : 'en');
})();
</script>
</body>
</html>
